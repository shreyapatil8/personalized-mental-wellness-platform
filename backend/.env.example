PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/wellness_research
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
# Empty values use ml/.venv and the trained bundle in this workspace.
PYTHON_EXECUTABLE=
ML_MODEL_PATH=
# Student assistant and optional counsellor briefing both use local Ollama only.
ASSISTANT_OLLAMA_BASE_URL=http://127.0.0.1:11434
ASSISTANT_OLLAMA_MODEL=qwen3:1.7b
ASSISTANT_OLLAMA_TIMEOUT_MS=180000
# Counsellor briefing only. The factual overview remains available without Ollama.
COUNSELLOR_BRIEFING_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT_MS=120000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

